        super(maSV, hoTen);
        this.diemMarketing = diemMarketing;
    }

    @Override
    public void hienThiThongTin() {
        System.out.println("[SV KT] Mã: " + getMaSV() + " | Tên: " + getHoTen() + " | Điểm Marketing: " + diemMarketing);
    }
}
